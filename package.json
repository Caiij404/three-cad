    "check:solid": "node scripts/check-solid.mjs",
    "check:solid:browser": "node scripts/check-solid-browser.mjs",
    "check:worker": "node --test tests/worker-rpc.test.mjs",
    "check:gate": "node scripts/check-gate-browser.mjs",
    "check:workspace:state": "node --test tests/workspace-state.test.mjs",
    "check:workspace": "node scripts/check-workspace-browser.mjs",
    "check:domain": "node scripts/check-domain.mjs",
    "check:project": "node scripts/check-project-browser.mjs",
