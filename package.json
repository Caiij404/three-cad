  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-vue": "6.0.9",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vue-tsc": "3.3.11"
