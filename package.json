{
  "name": "three-cad-vue",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check:docs": "node scripts/check-docs.mjs",
    "check:bootstrap": "node scripts/check-bootstrap.mjs",
    "check:solver": "node scripts/check-solver.mjs",
    "check:solver:browser": "node scripts/check-solver-browser.mjs",
    "check:solid": "node scripts/check-solid.mjs",
    "check:solid:browser": "node scripts/check-solid-browser.mjs",
    "check:worker": "node --test tests/worker-rpc.test.mjs",
    "check:gate": "node scripts/check-gate-browser.mjs",
    "check:workspace:state": "node --test tests/workspace-state.test.mjs",
    "check:workspace": "node scripts/check-workspace-browser.mjs",
    "check:domain": "node scripts/check-domain.mjs",
    "check:project": "node scripts/check-project-browser.mjs",
    "check:plane": "node scripts/check-plane.mjs",
    "check:viewport": "node scripts/check-viewport-browser.mjs",
    "check:domain-solver": "node scripts/check-domain-solver.mjs",
    "check:domain-solver:browser": "node scripts/check-domain-solver-browser.mjs",
    "check:drawing": "node scripts/check-drawing.mjs",
    "check:drawing:browser": "node scripts/check-drawing-browser.mjs",
    "record:solver": "node scripts/record-solver-build.mjs",
    "record:toolchain": "node scripts/record-toolchain.mjs",
    "learn:typecheck": "node scripts/probe-typecheck.mjs",
    "check:sketch-edit": "node scripts/check-sketch-edit.mjs",
    "check:sketch-edit:browser": "node scripts/check-sketch-edit-browser.mjs",
    "check:linear-constraints": "node scripts/check-linear-constraints.mjs",
    "check:linear-constraints:browser": "node scripts/check-linear-constraints-browser.mjs",
    "check:tangent-primitives": "node scripts/check-tangent-primitives.mjs",
    "check:tangency": "node scripts/check-tangency.mjs",
    "check:tangency:browser": "node scripts/check-tangency-browser.mjs",
    "check:diagnostics": "node --test tests/sketch-diagnostics.test.mjs",
    "check:constraint-edit": "node scripts/check-constraint-edit.mjs",
    "check:constraints:browser": "node scripts/check-constraints-browser.mjs"
  },
  "dependencies": {
    "pinia": "4.0.3",
    "three": "0.186.1",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-vue": "6.0.9",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vue-tsc": "3.3.11"
  }
}
